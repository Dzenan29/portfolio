# Base path the site is served from. "/portfolio" for https://dzenan29.github.io/portfolio,
# empty for a custom domain or the dev server.
NEXT_PUBLIC_BASE_PATH=

# Absolute public URL (no trailing slash). Used for canonical URLs, hreflang, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://dzenan29.github.io/portfolio

# Optional: endpoint of a form-delivery service that accepts JSON POSTs (e.g. Formspree:
# https://formspree.io/f/<id>). Without it the contact page shows direct contact links only
# and NO form is rendered. Never put SMTP credentials or private keys here - this value is public.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
